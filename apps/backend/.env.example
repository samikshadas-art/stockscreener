# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockscreener
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/stockscreener

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# ── Supabase (optional, for managed DB + Auth) ───────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── External Data APIs ────────────────────────────────────────────────────────
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Twelve Data: https://twelvedata.com/
TWELVE_DATA_KEY=

# Polygon.io: https://polygon.io/
POLYGON_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
